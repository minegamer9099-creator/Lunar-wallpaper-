<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/versionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/version_label"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="22dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/home_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:background="@color/preview_background">

            <com.lumadrift.wallpaper.WallpaperPreviewView
                android:id="@+id/wallpaperPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <VideoView
                android:id="@+id/videoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/video_preview_description"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/previewCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/preview_caption"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="@string/video_section_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selectedVideoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/no_video_selected"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/video_resolution_note"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/videoLoopControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_loop_range_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/videoLoopEnabledSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/video_loop_enabled"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/loopRangeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/video_loop_description"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/loopRangeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="@string/loop_range_summary_default" />

            <com.lumadrift.wallpaper.LoopRangeTimelineView
                android:id="@+id/loopRangeTimeline"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:contentDescription="@string/loop_range_timeline_description" />

            <TextView
                android:id="@+id/loopStartLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/loop_start_label"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/loopStartSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="99"
                android:progress="0" />

            <TextView
                android:id="@+id/loopStartValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/loop_range_time_default"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/loopEndLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/loop_end_label"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/loopEndSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100" />

            <TextView
                android:id="@+id/loopEndValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/loop_range_time_default"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/loopRangeValidation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/resetLoopRangeButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/control_background"
                android:text="@string/reset_loop_range"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/chooseVideoButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/control_background"
            android:text="@string/choose_video"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/clearVideoButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/control_background"
            android:text="@string/use_default_wallpaper"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <ToggleButton
            android:id="@+id/animationToggle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/toggle_background"
            android:checked="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textOff="@string/animation_off"
            android:textOn="@string/animation_on"
            android:textSize="14sp" />

        <Button
            android:id="@+id/setWallpaperButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/accent"
            android:text="@string/set_wallpaper"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="@string/offline_note"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
